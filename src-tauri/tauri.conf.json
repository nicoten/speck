{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speck",
  "version": "0.1.0",
  "identifier": "com.nicotejera.speck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Speck",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNkMxQTlDQkUwNkM1RUMKUldUc3hRYStuQnBzWG44MnA1Wlg3c0FjVFJnRVlkZDl0akZXSUNiZ1JHWkl2dUZ2SE5scHQ5V1IK",
      "endpoints": [
        "https://github.com/nicoten/speck/releases/latest/download/latest.json"
      ]
    }
  }
}